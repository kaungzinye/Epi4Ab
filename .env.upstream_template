# Upstream Epi4Ab Preprocessing Environment Variables
# Copy this to .env and update paths for your system

# Base directories
CURRENT_WORKING_DIRECTORY="/leonardo_work/AIFAC_F01_302/Epi4Ab"
DIRECTORY_INPUT="${CURRENT_WORKING_DIRECTORY}/input"
DIRECTORY_PREPROCESS_OUTPUT="/leonardo_scratch/fast/AIFAC_F01_302/epi4ab/upstream_preprocess"

# Required executables
# NOTE: PyMOL and MAFFT are NOT currently installed on this system
# You need to install them before running upstream preprocessing:
#
# Option 1: Install via conda (recommended for HPC)
#   conda install -c conda-forge pymol-open-source
#   conda install -c bioconda mafft
#   Then set paths to: $(conda info --base)/envs/<env_name>/bin/pymol
#
# Option 2: Install via pip (may not work for PyMOL on HPC)
#   pip install pymol-open-source
#   pip install mafft-python  # Note: this is Python wrapper, may need system mafft
#
# Option 3: Download and compile from source (most reliable for HPC)
#   PyMOL: https://github.com/schrodinger/pymol-open-source
#   MAFFT: https://mafft.cbrc.jp/alignment/software/
#
# After installation, update the paths below:
PYMOL_EXECUTABLE="/leonardo_work/AIFAC_F01_302/Epi4Ab/tools/conda/envs/epi4ab-upstream/bin/pymol"
MAFFT_EXECUTABLE="/leonardo_work/AIFAC_F01_302/Epi4Ab/tools/conda/envs/epi4ab-upstream/bin/mafft"

# Preprocessing paths (used by run_preprocess.sh)
DIRECTORY_PDB_INFO="${DIRECTORY_INPUT}/pdb_info.csv"
DIRECTORY_PROCESSED="${DIRECTORY_PREPROCESS_OUTPUT}/processed_data"
DIRECTORY_NODES_EDGES="${DIRECTORY_PREPROCESS_OUTPUT}/nodes_edges"
DIRECTORY_METADATA="${DIRECTORY_PREPROCESS_OUTPUT}/metadata.csv"

